         if (!g_layer_kv_slots[i].active) {
             g_layer_kv_slots[i].active = 1;
             g_layer_kv_slots[i].layer_idx = layer_idx;
+            g_layer_kv_slots[i].last_pos = -1;
             
             // Allocate head-major GPU buffers
             if (!g_layer_kv_slots[i].d_k_cache) {
@@ -74,6 +75,17 @@
         if (g_layer_kv_slots[i].active && g_layer_kv_slots[i].layer_idx == layer_idx) {
             // We found an existing slot.
             // If pos == 0, the engine reset the generation, so we ignore stale cache.
+            if (pos > 0 && g_layer_kv_slots[i].last_pos != -1 && pos != g_layer_kv_slots[i].last_pos + 1) {
+                // A jump happened! We need to sync [0..pos-1] from host cache to device cache immediately.
+                // Since we are maintaining a contiguous head-major cache, we do segment-wise copies.
+                for (int h = 0; h < kv_num_heads; ++h) {
+                    float* h_k_head = kv_cache_k + (layer_idx * kv_num_heads * seq_len * kv_head_dim) + (h * seq_len * kv_head_dim);
+                    float* h_v_head = kv_cache_v + (layer_idx * kv_num_heads * seq_len * kv_head_dim) + (h * seq_len * kv_head_dim);
+                    
+                    cudaMemcpyAsync(g_layer_kv_slots[i].d_k_cache + (h * seq_len * kv_head_dim), h_k_head, pos * kv_head_dim * sizeof(float), cudaMemcpyHostToDevice, stream);
+                    cudaMemcpyAsync(g_layer_kv_slots[i].d_v_cache + (h * seq_len * kv_head_dim), h_v_head, pos * kv_head_dim * sizeof(float), cudaMemcpyHostToDevice, stream);
+                }
+            }
+            g_layer_kv_slots[i].last_pos = pos;
             return &g_layer_kv_slots[i];
         }
     }
